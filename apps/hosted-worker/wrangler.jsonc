{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dcat-hosted",
  "main": "src/worker-entry.ts",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "../web/dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // `id` is required for a standalone `worker:deploy`. Cloudflare Pages uses its
  // own DCAT_SESSIONS binding and does not read this file at deploy time.
  "kv_namespaces": [
    { "binding": "DCAT_SESSIONS" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_DO", "class_name": "RelaySessionDO" }
    ]
  },
  "exports": {
    "RelaySessionDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
