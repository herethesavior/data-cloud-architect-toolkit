{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@dcat/core": ["./packages/core/src/index.ts"],
      "@dcat/salesforce-cli": ["./packages/salesforce-cli/src/index.ts"],
      "@dcat/data360-api": ["./packages/data360-api/src/index.ts"],
      "@dcat/exporters": ["./packages/exporters/src/index.ts"],
      "@dcat/test-fixtures": ["./packages/test-fixtures/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
