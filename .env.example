# Non-secret local configuration only. Never put Salesforce credentials here.
# Port for the local connector (bound to 127.0.0.1 only).
DCAT_PORT=3847

# Start the connector directly in demo mode (fixture data, no Salesforce CLI used).
DCAT_DEMO=false

# Directory used for future local snapshot/export files.
DCAT_DATA_DIR=.dcat-data
