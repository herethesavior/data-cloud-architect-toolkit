{
  "name": "dcat",
  "version": "0.1.0",
  "description": "Data Cloud Architect Toolkit - local-first Data 360 discovery workbench",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n connector,web -c cyan,magenta \"npm:dev:connector\" \"npm:dev:web\"",
    "dev:connector": "tsx watch apps/local-connector/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "postbuild": "node scripts/build-pages.mjs",
    "build:hosted": "npm run typecheck && vite build --config apps/web/vite.config.ts --mode hosted",
    "build:pages": "npm run build:hosted && node scripts/build-pages.mjs",
    "pages:dev": "npm run build:pages && wrangler pages dev apps/web/dist --kv=DCAT_SESSIONS --port 8788 --compatibility-date=2026-11-18",
    "build:bridge": "npm run build --workspace @dcat-toolkit/bridge",
    "pack:bridge": "npm pack --workspace @dcat-toolkit/bridge",
    "start": "tsx apps/local-connector/src/index.ts --serve-static",
    "worker:dev": "npm run build:hosted && wrangler dev --config apps/hosted-worker/wrangler.jsonc",
    "worker:deploy": "npm run build:hosted && wrangler deploy --config apps/hosted-worker/wrangler.jsonc",
    "worker:dry-run": "npm run build:hosted && wrangler deploy --dry-run --config apps/hosted-worker/wrangler.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test && playwright test --config playwright.hosted.config.ts",
    "test:e2e:local": "playwright test",
    "test:e2e:hosted": "playwright test --config playwright.hosted.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@fastify/static": "^10.1.12",
    "@tanstack/query-async-storage-persister": "^5.108.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-query-persist-client": "^5.108.0",
    "@xyflow/react": "^13.0.2",
    "fastify": "^5.12.8",
    "hono": "^4.13.19",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
